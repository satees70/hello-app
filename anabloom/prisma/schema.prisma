// Anabloom — property-management accounting (multi-company).
//
// DEV: SQLite (provider "sqlite", DATABASE_URL="file:./dev.db").
// PROD: switch `provider` to "postgresql" and set DATABASE_URL (pooled 6543,
//       pgbouncer=true) + DIRECT_URL (direct 5432) to the dedicated Supabase
//       project. See README "SQLite -> Supabase switch" and the multi-company
//       migration runbook.
//
// Enums are modelled as String columns so the SAME schema works on both SQLite
// (dev) and Postgres (prod). Money is Prisma Decimal (never float).
//
// MULTI-COMPANY: every business entity carries a required companyId. A Company
// belongs to a User (owner). All queries are scoped by companyId via
// lib/company.ts. Books never mix between companies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  companies   Company[]
  csvMappings SavedCsvMapping[]
}

model Company {
  id             String   @id @default(cuid())
  userId         String
  name           String
  registrationNo String?
  currency       String   @default("RM")
  createdAt      DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       Account[]
  properties     Property[]
  tenants        Tenant[]
  leases         Lease[]
  leaseDocuments LeaseDocument[]
  journalEntries JournalEntry[]
  attachments    Attachment[]
  fixedAssets    FixedAsset[]
  lockedPeriods  LockedPeriod[]
  bankStatements BankStatement[]
  suppliers      Supplier[]
  bills          Bill[]

  @@index([userId])
}

model Account {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  type      String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  isSystem  Boolean @default(false)
  active    Boolean @default(true)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  address     String?
  monthlyRent Decimal  @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leases         Lease[]
  journalEntries JournalEntry[]
  fixedAssets    FixedAsset[]
  bills          Bill[]

  @@index([companyId])
}

model Tenant {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  idNumber  String? // IC number (individual tenant)
  regNoOld  String? // company old registration no. (e.g. 773261-M)
  regNoNew  String? // company new registration no. (e.g. 202501031985)
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leases  Lease[]

  @@index([companyId])
}

model Lease {
  id                 String    @id @default(cuid())
  companyId          String
  propertyId         String
  tenantId           String
  startDate          DateTime
  endDate            DateTime?
  monthlyRent        Decimal
  dueDay             Int       @default(1) // 1..28
  depositAmount      Decimal   @default(0)
  status             String    @default("ACTIVE") // ACTIVE | ENDED
  signedDate         DateTime?
  noticePeriodDays   Int?
  stampedDate        DateTime? // null => not stamped
  renewedFromLeaseId String?
  autoInvoice        Boolean   @default(true)
  createdAt          DateTime  @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  renewedFrom    Lease?          @relation("Renewal", fields: [renewedFromLeaseId], references: [id])
  renewals       Lease[]         @relation("Renewal")
  documents      LeaseDocument[]
  journalEntries JournalEntry[]

  @@index([companyId])
  @@index([propertyId])
  @@index([tenantId])
}

model LeaseDocument {
  id          String   @id @default(cuid())
  companyId   String
  leaseId     String
  label       String
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lease   Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([leaseId])
}

model JournalEntry {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String?
  leaseId      String?
  fixedAssetId String? // set for asset purchase / depreciation / disposal
  date         DateTime
  description  String
  sourceType   String
  periodKey    String? // "YYYY-MM" — set for auto-generated recurring rent invoices / depreciation
  createdAt    DateTime @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property    Property?     @relation(fields: [propertyId], references: [id])
  lease       Lease?        @relation(fields: [leaseId], references: [id])
  fixedAsset  FixedAsset?   @relation(fields: [fixedAssetId], references: [id])
  lines        JournalLine[]
  attachments  Attachment[]
  bill         Bill?         @relation("BillEntry")
  billPayments BillPayment[] @relation("PaymentEntry")

  @@unique([leaseId, periodKey])
  @@index([companyId])
  @@index([date])
  @@index([propertyId])
  @@index([leaseId])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0)
  credit    Decimal @default(0)

  // Cash lines (accounts 1000/1010) carry reconciliation state:
  reconciledAt    DateTime?
  statementLineId String?

  entry         JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [accountId], references: [id])
  statementLine StatementLine? @relation("LineMatch", fields: [statementLineId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([statementLineId])
}

model Attachment {
  id             String   @id @default(cuid())
  companyId      String
  journalEntryId String
  fileName       String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([journalEntryId])
}

model FixedAsset {
  id               String    @id @default(cuid())
  companyId        String
  propertyId       String?
  name             String
  cost             Decimal
  purchaseDate     DateTime
  method           String    @default("STRAIGHT_LINE")
  usefulLifeMonths Int
  salvageValue     Decimal   @default(0)
  assetAccountCode String    @default("1500") // 1500/1510/1520
  disposedAt       DateTime?
  createdAt        DateTime  @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id])
  entries  JournalEntry[]

  @@index([companyId])
}

model LockedPeriod {
  id        String   @id @default(cuid())
  companyId String
  yearMonth String // "YYYY-MM"
  lockedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, yearMonth])
  @@index([companyId])
}

model BankStatement {
  id             String    @id @default(cuid())
  companyId      String
  fileName       String
  bankName       String?
  accountLabel   String?
  periodStart    DateTime
  periodEnd      DateTime
  openingBalance Decimal
  closingBalance Decimal
  status         String    @default("DRAFT") // DRAFT | REVIEWED | RECONCILED
  reportJson     String? // stored reconciliation report (JSON)
  uploadedAt     DateTime  @default(now())
  reconciledAt   DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   StatementLine[]

  @@index([companyId])
}

model StatementLine {
  id                   String   @id @default(cuid())
  statementId          String
  date                 DateTime
  description          String
  amount               Decimal // signed: + money in, - money out
  runningBalance       Decimal?
  matchStatus          String   @default("UNMATCHED") // UNMATCHED|AUTO_MATCHED|CONFIRMED|ENTRY_CREATED|IGNORED
  matchedJournalLineId String?
  matchConfidence      Float?
  sortOrder            Int      @default(0)

  statement    BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedLines JournalLine[] @relation("LineMatch")

  @@index([statementId])
}

model SavedCsvMapping {
  id          String   @id @default(cuid())
  userId      String
  bankName    String
  mappingJson String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankName])
  @@index([userId])
}

// ---------------- Suppliers & accounts payable (PART C) ----------------

model Supplier {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  registrationNo   String?
  phone            String?
  email            String?
  defaultTermsDays Int      @default(30)
  notes            String?
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bills   Bill[]

  @@index([companyId])
}

model Bill {
  id             String   @id @default(cuid())
  companyId      String
  supplierId     String
  propertyId     String?
  billDate       DateTime
  dueDate        DateTime
  reference      String? // supplier invoice no.
  description    String
  amount         Decimal
  status         String   @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | VOID
  journalEntryId String?  @unique // the posting that created it
  createdAt      DateTime @default(now())

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier      @relation(fields: [supplierId], references: [id])
  property Property?     @relation(fields: [propertyId], references: [id])
  entry    JournalEntry? @relation("BillEntry", fields: [journalEntryId], references: [id])
  payments BillPayment[]

  @@index([companyId])
  @@index([supplierId])
}

model BillPayment {
  id             String   @id @default(cuid())
  billId         String
  journalEntryId String
  date           DateTime
  amount         Decimal
  createdAt      DateTime @default(now())

  bill  Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  entry JournalEntry @relation("PaymentEntry", fields: [journalEntryId], references: [id])

  @@index([billId])
  @@index([journalEntryId])
}
